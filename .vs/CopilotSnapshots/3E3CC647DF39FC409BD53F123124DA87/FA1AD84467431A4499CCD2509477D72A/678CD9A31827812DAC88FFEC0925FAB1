    struct Error {
        tokenizer::Token token;
        std::string message;

        Error(tokenizer::Token tok, std::string msg)
            : token(std::move(tok)), message(std::move(msg))
        {
        }

        void print(std::ostream& os, size_t indent = 0) const {
            do_indent(os, indent);
            os
                << token.line
                << ":"
                << token.col
                << ": "
                << message
                << ": "
                << token.value
                << "\n";
        }
    };



    class Node {
    public:
        virtual ~Node() = default;

